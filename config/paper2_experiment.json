      1.0,
      1.0,
      1.0
    ],
    "process_noise_std_m_s2": [
      0.5,
      0.5,
      0.5
    ],
    "simulated_hp_ramp": {
      "formula": "base_hp * (0.3 + 0.7 * min(1.0, t_elapsed / 5.0))",
      "ramp_time_constant_s": 5.0,
      "ramp_floor": 0.3,
      "ramp_scale": 0.7
    }
  },
  "state_representation": {
    "state_dimension": 14,
    "features": [
      {
        "index": 0,
        "symbol": "s1",
        "name": "Current estimated range (normalized)",
        "scale": "R_t / 5000.0"
      },
      {
        "index": 1,
        "symbol": "s2",
        "name": "Range change from initial estimate (normalized)",
        "scale": "(R_t - R_0) / 1000.0"
      },
      {
        "index": 2,
        "symbol": "s3",
        "name": "Target length (normalized)",
        "scale": "L_t / 20.0"
      },
      {
        "index": 3,
        "symbol": "s4",
        "name": "Target width (normalized)",
        "scale": "W_t / 20.0"
      },
      {
        "index": 4,
        "symbol": "s5",
        "name": "Target height (normalized)",
        "scale": "H_t / 20.0"
      },
      {
        "index": 5,
        "symbol": "s6",
        "name": "Estimated x-velocity (affine normalized)",
        "scale": "(v_x + 50) / 100.0"
      },
      {
        "index": 6,
        "symbol": "s7",
        "name": "Estimated y-velocity (affine normalized)",
        "scale": "(v_y + 50) / 100.0"
      },
      {
        "index": 7,
        "symbol": "s8",
        "name": "Estimated z-velocity (affine normalized)",
        "scale": "(v_z + 50) / 100.0"
      },
      {
        "index": 8,
        "symbol": "s9",
        "name": "Estimated speed magnitude (normalized)",
        "scale": "|v| / 100.0"
      },
      {
        "index": 9,
        "symbol": "s10",
        "name": "Time remaining fraction",
        "scale": "t_rem / T_max"
      },
      {
        "index": 10,
        "symbol": "s11",
        "name": "Absolute elapsed steps (normalized)",
        "scale": "episode_step / 100.0"
      },
      {
        "index": 11,
        "symbol": "s12",
        "name": "Clamped Kalman covariance trace",
        "scale": "min(1.0, Tr(P_t) / 1000.0)"
      },
      {
        "index": 12,
        "symbol": "s13",
        "name": "Target heading angle (normalized to [-1,1])",
        "scale": "psi_t / pi"
      },
      {
        "index": 13,
        "symbol": "s14",
        "name": "Closure rate indicator (capped)",
        "scale": "min(1.0, |R_dot| / 100.0)"
      }
    ]
  },
  "action_space": {
    "action_dimension": 2,
