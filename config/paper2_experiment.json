  "environment": {
    "tracking_duration_s": 10.0,
    "phase_completion_reference_steps": 50,
    "dynamic_episode_steps": {
      "fast_approach_long": 25,
      "very_fast_approach": 40,
      "range_above_3000_m": 100,
      "range_above_2500_m": 90,
      "default": 40
    },
    "dt_measurement_s": 0.5,
    "projectile_velocity_m_s": 800.0,
